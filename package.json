{
	"name": "fieldsync",
	"version": "0.0.0",
	"scripts": {
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
		"typecheck": "pnpm -r typecheck",
		"test:integration": "vitest run integration",
		"test:e2e": "pnpm --filter @fieldsync/web e2e"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"esbuild": "^0.28.2",
		"fast-check": "^4.10.3",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"private": true,
	"type": "module",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": ">=22"
	}
}
