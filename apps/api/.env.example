DATABASE_URL=postgres://fieldsync:fieldsync@127.0.0.1:5432/fieldsync
# At least 32 characters: openssl rand -base64 32
JWT_SECRET=
PORT=3000
LOG_LEVEL=info
# true when a proxy in front of the API sets X-Forwarded-For
TRUST_PROXY=false
# Sign-ins per account and address per 15 minutes
LOGIN_LIMIT=10
# Password of every demo user, created by `pnpm seed` or when the API starts
DEMO_PASSWORD=
# Connections each copy of the API opens; 3 on Vercel
DB_POOL_MAX=10
# Lets the daily job reset the demo; at least 16 characters (Vercel sends it)
CRON_SECRET=
